# DarkIndex permanent signing key — LOCAL settings.
#
# 1. Copy this file to "keystore.properties" (same folder). That file is git-ignored.
# 2. Fill in your values. Use FORWARD slashes in the path (backslashes are escape characters here).
# 3. Back up the .jks file and these passwords somewhere safe. Losing them = forced uninstall again.
#
# Every build (Android Studio Run, assembleRelease) is then signed with this key, matching the
# GitHub releases, so any build installs over any other without uninstalling.

storeFile=C:/Users/willr/keys/darkindex-release.jks
storePassword=CHANGE_ME
keyAlias=darkindex
keyPassword=CHANGE_ME
