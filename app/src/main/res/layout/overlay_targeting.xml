<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/validationContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_validation_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/overlayIpBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="#0f172a"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:text="192.168.1.1"
        android:textColor="#38bdf8"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/overlaySkipBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#f59e0b"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="⏭"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/overlayValidBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#16a34a"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="✓"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/overlayInvalidBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="6dp"
        android:backgroundTint="#dc2626"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="🗑"
        android:textColor="#ffffff"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/overlayCloseBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:backgroundTint="#475569"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="✕"
        android:textColor="#ffffff"
        android:textSize="18sp" />
</LinearLayout>
