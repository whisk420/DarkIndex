<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1120"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#e2e8f0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Settings &amp; Account"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Google Account Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#050811"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Google Account"
                android:textColor="#0ea5e9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Account User Info Layout -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/userAvatarIv"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="User Avatar"
                    android:src="@android:drawable/ic_menu_myplaces"
                    app:tint="#38bdf8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/userNameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#ffffff"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="John Doe" />

                    <TextView
                        android:id="@+id/userEmailTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#94a3b8"
                        android:textSize="13sp"
                        tools:text="johndoe@gmail.com" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sign In Button (Google Play build when signed out) -->
            <Button
                android:id="@+id/signInBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#0ea5e9"
                android:text="Sign In with Google"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Sign Out Button (Google Play build when signed in) -->
            <Button
                android:id="@+id/signOutBtn"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#dc2626"
                android:text="Sign Out"
                android:textColor="#ffffff"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Standalone Build Disclaimer (Standalone build only) -->
            <TextView
                android:id="@+id/standaloneDisclaimerTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Standalone Build: Cloud sync unavailable in offline build."
                android:textColor="#94a3b8"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Cloud Data Controls Section Card -->
        <LinearLayout
            android:id="@+id/cloudControlsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#050811"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cloud Data Controls"
                android:textColor="#0ea5e9"
                android:textSize="14sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/autoSyncCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="#0ea5e9"
                android:text="Auto-Sync Data to Google Account Space"
                android:textColor="#ffffff"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lastSyncTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Last Synced: Never"
                android:textColor="#94a3b8"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/backupNowBtn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#16a34a"
                    android:text="Backup Now"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/restoreNowBtn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#0284c7"
                    android:text="Restore Data"
                    android:textColor="#ffffff"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Privacy & Security Guarantee Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#050811"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy &amp; Control Guarantee"
                android:textColor="#10b981"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your data is strictly stored locally on your device by default. Cloud backup options operate exclusively within your personal Google Account storage space with zero third-party server involvement."
                android:textColor="#94a3b8"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
