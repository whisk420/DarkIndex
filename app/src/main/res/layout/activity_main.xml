<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b1120"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="#0b1120">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="DarkIndex"
            app:titleTextColor="#f8fafc">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <!-- Knowledge Base -->
                <ImageButton
                    android:id="@+id/knowledgeBaseBtn"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Knowledge Base"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#e2e8f0" />

                <ImageButton
                    android:id="@+id/siphonAlertsBtn"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Siphon Alerts"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#e2e8f0" />

                <!-- Raw Dumps (debug) — replaces Siphon Alerts while Raw Dump Mode is on -->
                <ImageButton
                    android:id="@+id/rawDumpsBtn"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Raw Dumps"
                    android:src="@android:drawable/ic_menu_save"
                    android:visibility="gone"
                    app:tint="#f87171" />

                <ImageButton
                    android:id="@+id/settingsBtn"
                    android:layout_width="48dp"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="#e2e8f0" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Search Bar -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:boxBackgroundColor="#1e293b"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp"
            app:endIconMode="clear_text"
            app:endIconTint="#94a3b8"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="#94a3b8"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="IP, name, clan · lvl 30 · fw 20 · sw 20"
                android:paddingVertical="12dp"
                android:textColor="#f8fafc"
                android:textColorHint="#64748b"
                android:textSize="15sp"
                android:inputType="textVisiblePassword"
                android:imeOptions="actionSearch" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Toggles Row -->
        <LinearLayout
            android:id="@+id/togglesLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/searchLayout">

            <!-- Recon Mode Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/reconModeCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:text="Recon Mode"
                android:textColor="#e2e8f0"
                android:textSize="14sp"
                app:useMaterialThemeColors="false"
                app:thumbTint="#f59e0b"
                app:trackTint="#1e293b"/>

            <!-- Spam Priority Toggle -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/goodSpamCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spam Priority"
                android:textColor="#e2e8f0"
                android:textSize="14sp"
                app:useMaterialThemeColors="false"
                app:thumbTint="#38bdf8"
                app:trackTint="#1e293b"/>
        </LinearLayout>

        <!-- Firewall Slider Row (visible only when Spam Priority is on) -->
        <LinearLayout
            android:id="@+id/firewallSliderLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/togglesLayout">

            <TextView
                android:id="@+id/maxFirewallLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Max FW:"
                android:textColor="#94a3b8"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/maxFirewallSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:max="31"
                android:progress="20"
                android:thumbTint="#38bdf8"
                android:progressTint="#38bdf8" />

            <TextView
                android:id="@+id/maxFirewallValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="20"
                android:textAlignment="viewEnd"
                android:textColor="#f8fafc"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shown while your own level is unknown (Spam advice can't account for the level gap) -->
        <TextView
            android:id="@+id/levelUnknownBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="#422006"
            android:padding="10dp"
            android:text="⚠ Your level isn't known yet. Scrape your own Home screen for accurate Spam advice."
            android:textColor="#fde68a"
            android:textSize="13sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/firewallSliderLayout" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/targetsRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingHorizontal="6dp"
            android:paddingBottom="88dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/levelUnknownBanner"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/firewallSliderLayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="📭"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="No targets captured yet.\n\nTap the 📸 overlay to scan your HackEx 2 game screens!"
                android:textAlignment="center"
                android:textColor="#94a3b8"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/marathonBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="84dp"
        android:layout_gravity="bottom|end"
        android:text="MARATHON"
        android:textColor="#ffffff"
        app:backgroundTint="#2563eb"
        app:icon="@android:drawable/ic_menu_recent_history"
        app:iconTint="#ffffff" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/validateBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_gravity="bottom|end"
        android:text="VALIDATE"
        android:textColor="#ffffff"
        app:backgroundTint="#16a34a"
        app:icon="@android:drawable/ic_menu_crop"
        app:iconTint="#ffffff" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
