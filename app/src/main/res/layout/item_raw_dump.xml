<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_node_card"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Row 1: big local timestamp + expand chevron -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timestampText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="#f8fafc"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expandBtn"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▸"
                android:textColor="#38bdf8"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- Row 2: #id · UTC time · foreground package -->
        <TextView
            android:id="@+id/metaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#64748b"
            android:textSize="11sp" />

        <!-- Row 3: screen type chip + result -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/typeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:fontFamily="sans-serif-condensed"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#e2e8f0"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 4: matched parsers, log stats, size -->
        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <!-- Row 5: error (only when present) -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#f87171"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Expanded: full stored JSON -->
        <TextView
            android:id="@+id/detailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#020617"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#cbd5e1"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Long-press overlay -->
    <LinearLayout
        android:id="@+id/actionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f00b1120"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#7f1d1d"
            android:paddingHorizontal="20dp"
            android:text="DELETE"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
