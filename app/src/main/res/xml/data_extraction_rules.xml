<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and newer.
  cloud-backup: everything excluded, so no DarkIndex data is uploaded to Google Drive / Google One.
  device-transfer: left at Android's default (a direct phone-to-phone copy by cable or local Wi-Fi when you
  set up a new phone; no cloud involved), so moving to a new phone keeps your database.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
