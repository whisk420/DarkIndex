<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older. Backup is off (android:allowBackup="false" in the manifest); these exclusions
  make the intent explicit: nothing DarkIndex stores is ever handed to Google's cloud backup.
  Your own backups are the Downloads/DarkIndex copy and ⋮ → Export Data.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
